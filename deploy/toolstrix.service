[Unit]
Description=toolstrix 2.0 media downloader
After=network.target

[Service]
Type=simple
User=ytdlpweb
Group=ytdlpweb
WorkingDirectory=/opt/toolstrix
ExecStart=/opt/toolstrix/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8098 --workers 1
Restart=on-failure
RestartSec=5

MemoryHigh=350M
MemoryMax=450M
CPUQuota=70%

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/tmp /opt/toolstrix

[Install]
WantedBy=multi-user.target
